DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insightdocs"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="25"
RATE_LIMIT_CHAT_PER_MIN="20"
RATE_LIMIT_UPLOAD_PER_HOUR="30"

# Set true on a worker dyno so uploads only queue; Next.js skips inline processing.
USE_DOCUMENT_WORKER="false"
