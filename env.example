DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insightdocs"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Groq: chat (required). See https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_CHAT_MODEL="llama-3.1-8b-instant"

# Embeddings (768-dim pgvector): if OPENAI_API_KEY is set, OpenAI is used (reliable).
# If not set, Groq is used — many accounts get 404 on Groq embed models; then set OPENAI_API_KEY for embeddings only.
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
GROQ_EMBEDDING_MODEL="nomic-embed-text-v1.5"
# Force backend: auto (default) | openai | groq
# EMBEDDING_PROVIDER="auto"

UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="25"
RATE_LIMIT_CHAT_PER_MIN="20"
RATE_LIMIT_UPLOAD_PER_HOUR="30"

# Set true on a worker dyno so uploads only queue; Next.js skips inline processing.
USE_DOCUMENT_WORKER="false"

# --- Docker (see Dockerfile + docker-compose.yml) ---
# docker compose up --build
# Then open http://localhost:3000 — Postgres with pgvector is on localhost:5432.
# Set AUTH_SECRET and GROQ_API_KEY. Add OPENAI_API_KEY if Groq embeddings return 404.
# In containers, DATABASE_URL is set by compose; UPLOAD_DIR defaults to /app/data/uploads (named volume).
# Default compose uses USE_DOCUMENT_WORKER=false so the app processes uploads without a worker container.
# Optional: USE_DOCUMENT_WORKER=true docker compose --profile worker up --build
